{
  "name": "nodeit",
  "version": "0.1.0",
  "description": "Portable Node-based visualization shell",
  "main": "main.js",
  "author": "ZeysMockingjay",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack:linux": "electron-builder --linux AppImage tar.gz",
    "desktop:install": "node scripts/install-desktop-entry.js"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nodeit.app",
    "productName": "NodeIt",
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Graphics"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ]
  }
}
